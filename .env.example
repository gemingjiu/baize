# ============================================================================
# 白泽（baize）环境变量样例
#
# 用法：复制本文件为 .env（根目录，供 docker-compose / start-backend.ps1 读取）
#       或 baize-backend/deploy/docker-compose/.env（仅供 compose 使用）。
# .gitignore 已忽略 .env / .env.*（白名单仅本文件），禁止提交真实值。
#
# 原则：jwt.secret、数据库/Redis/Nacos 口令一律走环境变量或 Nacos 加密配置，
#       不落仓库、不写进日志。新增占位符时请同步更新本文件（README 十.3）。
# ============================================================================

# ---------------------------------------------------------------------------
# Docker Compose（baize-backend/deploy/docker-compose/）
# ---------------------------------------------------------------------------
# PostgreSQL 超级用户口令（compose 强制要求，未提供会直接报错退出）
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Nacos 连接（baize-backend/.env；k3s NodePort 见 README）
# ---------------------------------------------------------------------------
# Nacos 登录用户名（application.yml 中为 ${NACOS_USERNAME:nacos}）
NACOS_USERNAME=nacos
# Nacos 登录密码
NACOS_PASSWORD=
# Nacos 服务地址（默认 localhost:8848）
NACOS_SERVER_ADDR=192.168.5.4:30848
# Nacos 命名空间 ID（必须填 ID，不是显示名；默认 baize）
NACOS_NAMESPACE=baize

# ---------------------------------------------------------------------------
# 认证 / 凭据（由 Nacos 配置引用，变量在启动进程环境中注入）
# ---------------------------------------------------------------------------
# JWT 签名密钥（baize-auth：${BAIZE_JWT_SECRET}，至少 32 字节随机字符串，为空启动失败）
BAIZE_JWT_SECRET=

# ---------------------------------------------------------------------------
# Nacos 服务端自身鉴权（k8s/03-nacos.yaml；生产必须全部替换默认值）
# ---------------------------------------------------------------------------
# Base64 编码的 Nacos 鉴权 Token（原文长度 >= 32 字节）
NACOS_AUTH_TOKEN=
# 服务端识别请求来源的 key/value 对
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
