<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baize.system.mapper.SysIdGenMapper">

    <resultMap type="com.baize.system.domain.SysIdGen" id="SysIdGenResult">
            <result property="id" column="id"/>
            <result property="maxId" column="max_id"/>
            <result property="step" column="step"/>
            <result property="bizType" column="biz_type"/>
            <result property="bizDesc" column="biz_desc"/>
            <result property="sort" column="sort"/>
            <result property="status" column="status"/>
            <result property="deleted" column="deleted"/>
            <result property="version" column="version"/>
            <result property="createdBy" column="created_by"/>
            <result property="createdTime" column="created_time"/>
            <result property="modifiedBy" column="modified_by"/>
            <result property="modifiedTime" column="modified_time"/>
            <result property="remark" column="remark"/>
    </resultMap>

    <sql id="selectSysIdGeneratorVo">
        select id, max_id, step, biz_type,biz_desc, sort, status, deleted, version, created_by, created_time, modified_by, modified_time, remark
        from sys_id_gen
    </sql>

    <select id="selectSysIdGenList" parameterType="com.baize.system.domain.SysIdGen" resultMap="SysIdGenResult">
        <include refid="selectSysIdGeneratorVo"/>
        <where>
            <if test="id != null  and id != ''"> and id = #{id}</if>
            <if test="maxId != null  and maxId != ''"> and max_id = #{maxId}</if>
            <if test="step != null  and step != ''"> and step = #{step}</if>
            <if test="bizType != null  and bizType != ''"> and biz_type = #{bizType}</if>
            <if test="bizDesc != null  and bizDesc != ''"> and biz_desc = #{bizDesc}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by sort
    </select>

    <select id="selectSysIdGenById" parameterType="String"
            resultMap="SysIdGenResult">
            <include refid="selectSysIdGeneratorVo"/>
            where id = #{id}
    </select>

    <insert id="insertSysIdGen" parameterType="com.baize.system.domain.SysIdGen" useGeneratedKeys="true"
            keyProperty="id">
        insert into sys_id_gen (
        <if test="id != null  and id != ''"> id, </if>
        <if test="maxId != null  and maxId != ''"> max_id, </if>
        <if test="step != null  and step != ''"> step, </if>
        <if test="bizType != null  and bizType != ''"> biz_type, </if>
        <if test="bizDesc != null  and bizDesc != ''"> biz_desc, </if>
        <if test="sort != null">sort,</if>
        <if test="status != null">status,</if>
        <if test="remark != null and remark != ''">remark,</if>
        <if test="createdBy != null and createdBy != ''">created_by,</if>
        created_time
        )values(
        <if test="id != null  and id != ''">#{id},</if>
        <if test="maxId != null  and maxId != ''">#{maxId},</if>
        <if test="step != null  and step != ''">#{step},</if>
        <if test="bizType != null  and bizType != ''">#{bizType},</if>
        <if test="bizDesc != null  and bizDesc != ''">#{bizDesc},</if>
        <if test="sort != null">#{sort},</if>
        <if test="status != null">#{status},</if>
        <if test="remark != null and remark != ''">#{remark},</if>
        <if test="createdBy != null and createdBy != ''">#{createdBy},</if>
        now()
        )
    </insert>

    <update id="updateSysIdGen" parameterType="com.baize.system.domain.SysIdGen">
        update sys_id_gen
        <set>
            <if test="maxId != null  and maxId != ''"> max_id = #{maxId},</if>
            <if test="step != null  and step != ''"> step = #{step},</if>
            <if test="bizType != null  and bizType != ''"> biz_type = #{bizType},</if>
            <if test="bizDesc != null  and bizDesc != ''"> biz_desc = #{bizDesc},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
            <if test="version != null">version = #{version}+1,</if>
            <if test="remark != null and remark != ''">remark = #{remark},</if>
            <if test="modifiedBy != null and modifiedBy != ''">modified_by = #{modifiedBy},</if>
            modified_time = now()
        </set>
        where id = #{id}
    </update>
    <update id="updateSysIdGenStatus" parameterType="com.baize.system.domain.SysIdGen">
        update sys_id_gen
        <set>
        status = #{status}
        </set>
        where id = #{id}
    </update>

    <delete id="deleteSysIdGenById" parameterType="String">
        delete
        from sys_id_gen where id = #{id}
    </delete>

    <delete id="deleteSysIdGenByIds" parameterType="String">
        delete from sys_id_gen where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
